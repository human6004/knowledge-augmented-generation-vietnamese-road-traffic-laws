# Copy to .env; fill blanks with independent random secrets (32 bytes each).
# Protect .env; never commit it. Prepare token files per docs/INSTALL.md.
COMPOSE_PROJECT_NAME=luatgt
ADMIN_EMAIL=admin@luatgt.local
ADMIN_PASSWORD=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
MINIO_PASSWORD=
KAG_MYSQL_PASSWORD=
KAG_NEO4J_PASSWORD=
KAG_MINIO_PASSWORD=
# Local secrets/state are ignored by Git and Docker builds; never commit them.
KAG_STATE_DIR=./.secrets
KAG_CREDENTIALS_WRITE_SECRET_FILE=../luatgt-state/credentials-write.token
KAG_PROVIDER_TEST_SECRET_FILE=../luatgt-state/provider-test.token
KAG_CONFIG_APPLY_SECRET_FILE=../luatgt-state/config-apply.token
# Public HTTPS hosts: docker/kag-ingress/provider-hosts.lst (shared by API and gateway).
# Optional proxy URL registered explicitly; empty means public providers only.
KAG_PROVIDER_PROXY_BASE_URL=
# Only the optional proxy route needs verified retry/rotation/fallback policy.
KAG_CHAT_PROXY_TEST_SAFE=0
# Alternative: operator explicitly accepts retries/fallback within this registered proxy.
KAG_CHAT_PROXY_ALLOW_UPSTREAM_RETRIES=0
