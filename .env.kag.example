# KAG / OpenSPG only. Generate random credentials with docker/init-env.ps1 -Kag.
OPENSPG_MYSQL_PASSWORD=
OPENSPG_NEO4J_PASSWORD=
OPENSPG_MINIO_USER=minio
OPENSPG_MINIO_PASSWORD=
