{
  "profile": "shell-only",
  "readiness": "disabled",
  "production_write": "blocked",
  "interactive_documentation": "disabled",
  "request_body_limit_bytes": 65536,
  "body_timeout_seconds": 5,
  "service_principals": {
    "webapp-query": {
      "scopes": ["query"],
      "can_delegate_user": true,
      "secret_file_env": "KAG_HTTP_QUERY_SECRET_FILE",
      "previous_secret_file_env": "KAG_HTTP_QUERY_PREVIOUS_SECRET_FILE"
    },
    "inspect": {
      "scopes": ["inspect"],
      "can_delegate_user": false,
      "secret_file_env": "KAG_HTTP_INSPECT_SECRET_FILE",
      "previous_secret_file_env": "KAG_HTTP_INSPECT_PREVIOUS_SECRET_FILE"
    }
  }
}
